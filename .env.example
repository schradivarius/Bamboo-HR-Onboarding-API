# --- Harvest -----------------------------------------------------------------
# Personal Access Token + Account ID from https://id.getharvest.com/developers
HARVEST_TOKEN=
HARVEST_ACCOUNT_ID=
# Harvest rejects requests with no User-Agent. Put a real contact address here.
HARVEST_USER_AGENT=Aurora Onboarding (it@auroratechnical.example)

# --- BambooHR ----------------------------------------------------------------
BAMBOO_API_KEY=
BAMBOO_SUBDOMAIN=auroratechnical
# Returned ONCE when you create the webhook. Needed to verify deliveries.
BAMBOO_WEBHOOK_PRIVATE_KEY=
# See src/onboarding/webhook_auth.py -- "body_then_timestamp" matches
# BambooHR's own PHP sample. Run `onboarding diagnose-signature` on a real
# delivery if deliveries are being rejected.
BAMBOO_SIGNATURE_FORMAT=body_then_timestamp

# --- Behaviour ---------------------------------------------------------------
# TRUE by default on purpose: writing to Harvest creates billable seats.
DRY_RUN=true
# Only mirror employees hired within this many days (guards against a webhook
# backfill dragging in your entire history).
MAX_HIRE_AGE_DAYS=30
# Comma-separated. Harvest roles applied to every created user.
HARVEST_DEFAULT_ROLES=
# Treat BambooHR employment statuses in this list as contractors in Harvest.
BAMBOO_CONTRACTOR_STATUSES=Contractor,Temp,Intern
# Skip these BambooHR employment statuses entirely.
BAMBOO_SKIPPED_STATUSES=Terminated
